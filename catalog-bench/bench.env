# Per-cloud configuration for catalog-bench/bin/bench.sh.
# Sourced as bash; do not put complex shell logic here.

# === Workstation paths ===
YCSB_TREE=/home/chris/work/catalog/YCSB
ICEBERG_HOME=/home/chris/work/catalog/iceberg
FILEIO_CATALOG_HOME=/home/chris/work/catalog/fileio-catalog
RESULTS_ROOT=${YCSB_TREE}/catalog-bench/results

# === AWS ===
AWS_REGION=us-west-2
AWS_INSTANCE_TYPE=m5.4xlarge
AWS_SSH_USER=awsuser
AWS_SSH_PRIVATE_KEY=~/.ssh/id_ed25519
# Bucket per TIER (TIER=std → standard S3; TIER=x → S3 Express One Zone)
AWS_BUCKET_STD=lst-pbafvfgrapl
AWS_BUCKET_X=lst-pbafvfgrapl--usw2-az3--x-s3

# === Azure ===
AZURE_REGION="West US"
AZURE_VM_SIZE=Standard_D16s_v3
AZURE_SSH_USER=azureuser
# Bucket = storage account container per TIER (TIER=std → Standard SA; TIER=x → Premium SA)
AZURE_BUCKET_STD=lstnsgym/lst-ns-consistency
AZURE_BUCKET_X=lstnsgymx3serug/lstx-consistency

# === GCP ===
GCP_PROJECT=lst-consistency
GCP_REGION=us-west4
GCP_ZONE=us-west4-c
GCP_INSTANCE_TYPE=n2-standard-16
GCP_SSH_USER=gcpuser
# Bucket per TIER (TIER=std → standard class us-west4; TIER=rapid → existing zonal Rapid)
GCP_BUCKET_STD=lst-uw4-std
GCP_BUCKET_RAPID=lstx-consistency

# === Sweep matrix ===
# Space-separated lists; bench.sh iterates the cross product (minus unsafe combos).
SWEEP_AWS_TIERS="std x"
SWEEP_AZURE_TIERS="std x"
SWEEP_GCP_TIERS="std rapid"
SWEEP_CLIENTS="direct fileio"
SWEEP_MODES="cas append"
SWEEP_THREAD_RANGE="1..16"
SWEEP_RUNS=5
